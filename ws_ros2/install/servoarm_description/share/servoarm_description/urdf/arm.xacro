<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="servo_6dof_arm">

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}"
        iyy="${m*(x*x+z*z)/12.0}"
        izz="${m*(x*x+y*y)/12.0}"
        ixy="0"
        ixz="0"
        iyz="0"/>
    </inertial>
  </xacro:macro>

  <link name="world" />

  <joint name="world_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/base_cylinder.stl" scale="0.0001 0.0001 0.0001"/>
      </geometry>
      <origin xyz="0 0 0.01"/>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/base_cylinder.stl" scale="0.0001 0.0001 0.0001"/>
      </geometry>
      <origin xyz="0 0 0.01"/>
    </collision>
    <xacro:box_inertia m="0.25" x="0.18" y="0.18" z="0.02"/>
  </link>

  <link name="waist_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/top_plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/top_plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
    <xacro:box_inertia m="0.12" x="0.12" y="0.12" z="0.01"/>
  </link>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/lower_arm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/lower_arm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin xyz="0 0 0"/>
    </collision>
    <xacro:box_inertia m="0.20" x="0.25" y="0.05" z="0.03"/>
  </link>

  <link name="elbow_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/top_arm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 1.59 0" xyz="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/top_arm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 1.59 0" xyz="0 0 0"/>
    </collision>
    <xacro:box_inertia m="0.18" x="0.22" y="0.05" z="0.03"/>
  </link>

  <link name="wrist_pitch">
    <visual>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/wrist.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/wrist.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <xacro:box_inertia m="0.08" x="0.08" y="0.05" z="0.04"/>
  </link>

  <link name="wrist_roll">
    <visual>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/clawbase.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 3.18 0" xyz="0 0 0"/>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/clawbase.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 3.18 0" xyz="0 0 0"/>
    </collision>
    <xacro:box_inertia m="0.07" x="0.06" y="0.06" z="0.04"/>
  </link>

  <link name="right_gripper">
    <visual>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/clawr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/clawr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <xacro:box_inertia m="0.03" x="0.10" y="0.02" z="0.02"/>
  </link>

  <link name="left_gripper">
    <visual>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/clawl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find servoarm_description)/meshes/clawl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <xacro:box_inertia m="0.03" x="0.10" y="0.02" z="0.02"/>
  </link>

  <joint name="joint_1" type="revolute">
    <axis xyz="0 0 1" />
    <limit effort="1000.0" lower="-1.57" upper="1.57" velocity="1.0" />
    <parent link="base_link"/>
    <child link="waist_link"/>
    <origin rpy="0 0 1.5" xyz="0 0 0.48"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <axis xyz="1 0 0" />
    <limit effort="1000.0" lower="0.0" upper="1.57" velocity="1.0" />
    <parent link="waist_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0.19 0.28"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <axis xyz="1 0 0" />
    <limit effort="1000.0" lower="-1.57" upper="1.57" velocity="1.0" />
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="-0.25 1.0 0"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <axis xyz="1 0 0" />
    <limit effort="1000.0" lower="-1.57" upper="1.57" velocity="1.0" />
    <parent link="elbow_link"/>
    <child link="wrist_pitch"/>
    <origin xyz="0.11 1.25 0"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <axis xyz="0 1 0" />
    <limit effort="1000.0" lower="-1.57" upper="1.57" velocity="1.0" />
    <parent link="wrist_pitch"/>
    <child link="wrist_roll"/>
    <origin xyz="0 0.63 0"/>
  </joint>

  <joint name="joint_6" type="revolute">
    <axis xyz="0 0 1" />
    <limit effort="1000.0" lower="-0.2" upper="0.0" velocity="1.0" />
    <parent link="wrist_roll"/>
    <child link="right_gripper"/>
    <origin rpy="0 0 -0.31" xyz="0.11 0.34 0"/>
    <dynamics damping="0.01" friction="0.0"/> 
  </joint>

  <joint name="joint_7" type="revolute">
    <limit effort="1000.0" lower="0.0" upper="0.2" velocity="1.0" />
    <parent link="wrist_roll"/>
    <child link="left_gripper"/>
    <origin rpy="0 0 0.22" xyz="-0.16 0.30 0"/>
    <axis xyz="0 0 1"/>
    <mimic joint="joint_6" multiplier="-1.0" offset="0" />
    <dynamics damping="0.01" friction="0.0"/> 
  </joint>

</robot>